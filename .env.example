# Server
PORT=4000
NODE_ENV=development
# Public origin of the app (used for CSRF origin checks and links in emails)
APP_ORIGIN=http://localhost:5173

# Database: either a postgres:// URL (production) or a PGlite directory (development)
# DATABASE_URL=postgres://dms:change-me@localhost:5432/dms
# Optional direct (non-pooled) URL used for migrations, e.g. Neon's DATABASE_URL_UNPOOLED
# DATABASE_URL_UNPOOLED=postgres://...
PGLITE_DIR=.data/pglite

# File storage (private, outside any web root)
STORAGE_DIR=storage/uploads

# Optional SMTP for email notifications. When unset, emails are logged instead of sent.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Devtics DMS <no-reply@devtics.example>"
